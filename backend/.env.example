# CivicGrant IQ — Environment Variables
# Copy this file to .env and fill in your values from the Azure portal deployment outputs

# ── Azure Application Insights (civicgrant-insights) ────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=06041752-e419-48dd-986b-66fd8649a849;IngestionEndpoint=https://eastus2-3.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus2.livediagnostics.monitor.azure.com/;ApplicationId=690b54ce-e6ee-4dc0-b372-58d38d277bb3

# ── Azure AI Search Free tier (civicgrant-srch) ───────────────────────────────
SEARCH_ENDPOINT=https://civicgrant-srch.search.windows.net
SEARCH_API_KEY=<your-search-admin-key>
KNOWLEDGE_BASE_NAME=civicgrant-kb

# ── Azure OpenAI ─────────────────────────────────────────────────────────
AOAI_ENDPOINT=https://<your-openai-service>.openai.azure.com
AOAI_API_KEY=<your-azure-openai-api-key>
AOAI_GPT_DEPLOYMENT=gpt-4o-mini
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── Microsoft Foundry Project ─────────────────────────────────────────────
# Format: https://<hub>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<your-hub>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini

# ── Azure Blob Storage (Municipal Docs Corpus) ────────────────────────────
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
BLOB_CONTAINER_NAME=civicgrant-docs

# ── Azure Resource Details ────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rg-skillsfest
AZURE_LOCATION=eastus2

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
